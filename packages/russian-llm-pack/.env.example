# Copy to .env (gitignored!) and fill with your real keys.
# Keys are read from environment variables ONLY — never from YAML, never from code.

# DeepSeek (OpenAI-compatible) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Z.ai GLM (OpenAI-compatible) — https://z.ai / https://open.bigmodel.cn
ZAI_API_KEY=

# GigaChat (Sber) — access token obtained via OAuth, experimental in v0.1
# Full OAuth client-credentials flow is planned for v0.2
GIGACHAT_ACCESS_TOKEN=

# YandexGPT (Yandex Foundation Models) — native adapter planned for v0.2
YAIAM_TOKEN=
YC_FOLDER_ID=

# Optional: custom router config path (default: ./rlp.config.yaml)
# RLP_CONFIG=/path/to/rlp.config.yaml
