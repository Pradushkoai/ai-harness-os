# Copy to .env (gitignored!) and fill with your real keys.
# Keys are read from environment variables ONLY — never from YAML, never from code.

# DeepSeek (OpenAI-compatible) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Z.ai GLM (OpenAI-compatible) — https://z.ai / https://open.bigmodel.cn
ZAI_API_KEY=

# GigaChat (Sber, native adapter v0.2) — https://developers.sber.ru/gigachat
# Preferred: authorization key (base64 client_id:client_secret) — the adapter
# runs the OAuth flow itself and refreshes the access token automatically.
GIGACHAT_AUTH_KEY=
# Alternative: a ready access token (OAuth skipped, never refreshed). Quick tests only.
GIGACHAT_ACCESS_TOKEN=
# OAuth scope (default GIGACHAT_API_PERS; B2B clients use GIGACHAT_API_B2B)
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# TLS: GigaChat endpoints use the Russian Trusted CA. If the handshake fails:
# either point GIGACHAT_CA_BUNDLE at the CA file, or (dev only) set
# GIGACHAT_ALLOW_INSECURE=1 to skip verification.
# GIGACHAT_CA_BUNDLE=/path/to/russian-trusted-ca.pem
# GIGACHAT_ALLOW_INSECURE=1

# YandexGPT (Yandex Foundation Models, native adapter v0.2) — https://yandex.cloud
# Preferred: static API key of a service account (no expiry dance).
YANDEXGPT_API_KEY=
# Alternative: IAM token (Bearer; ~12h TTL; NOT auto-refreshed by the adapter).
YANDEXGPT_IAM_TOKEN=
# Folder id is REQUIRED for both auth modes (modelUri = gpt://<folder>/<model>).
YANDEXGPT_FOLDER_ID=

# Optional: custom router config path (default: ./rlp.config.yaml)
# RLP_CONFIG=/path/to/rlp.config.yaml
